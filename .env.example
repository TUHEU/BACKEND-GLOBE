# Copie ce fichier en ".env" (jamais committé - voir .gitignore) et
# remplis les vraies valeurs. Sans elles, tout fonctionne quand même
# (SECRET_KEY a une valeur par défaut, l'assistant IA échoue juste
# silencieusement sans clé) - rien de bloquant pour démarrer en dev.

# Clé de signature des tokens JWT. Change-la pour la prod (n'importe
# quelle chaîne aléatoire longue suffit) ; la valeur par défaut du code
# est seulement là pour que ça marche out-of-the-box en dev.
SECRET_KEY=

# Client IDs Google OAuth autorisés (Web + Android), séparés par des
# virgules. Pas des secrets en soi, mais gardés hors du code pour rester
# faciles à changer sans toucher aux sources.
GOOGLE_CLIENT_IDS=

# Clé API Gemini (gratuite sur ai.google.dev) pour l'assistant IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Clé OpenRouter (gratuite) - repli automatique si Gemini échoue/indisponible.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
